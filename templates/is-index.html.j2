<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>
        IS Aggregation Service | Version {{ image_tag | default('latest') }}
    </title>

    <style>
        body {
            margin: 0;
            font-family: Arial, Helvetica, sans-serif;
            background: linear-gradient(135deg, #0f172a, #1e293b);
            color: white;
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
        }

        .container {
            width: 85%;
            max-width: 1000px;
            text-align: center;
            padding: 50px;
            background: rgba(255, 255, 255, 0.08);
            border-radius: 20px;
            box-shadow: 0 10px 40px rgba(0, 0, 0, 0.4);
        }

        h1 {
            font-size: 42px;
            margin-bottom: 10px;
        }

        .subtitle {
            font-size: 20px;
            color: #cbd5e1;
            margin-bottom: 15px;
        }

        .version {
            display: inline-block;
            margin: 10px 0 30px 0;
            padding: 10px 22px;
            background: rgba(255, 255, 255, 0.12);
            border: 1px solid rgba(255, 255, 255, 0.2);
            border-radius: 25px;
            font-size: 18px;
            font-weight: bold;
            color: #ffffff;
        }

        .pipeline-title {
            margin-top: 10px;
            margin-bottom: 25px;
        }

        .pipeline {
            display: flex;
            justify-content: center;
            align-items: center;
            flex-wrap: wrap;
            gap: 12px;
            margin-top: 20px;
        }

        .tool {
            background: rgba(255, 255, 255, 0.12);
            padding: 15px 20px;
            border-radius: 12px;
            font-size: 16px;
            font-weight: bold;
            transition: transform 0.2s ease;
        }

        .tool:hover {
            transform: translateY(-3px);
        }

        .arrow {
            font-size: 24px;
            color: #cbd5e1;
        }

        .footer {
            margin-top: 40px;
            font-size: 14px;
            color: #94a3b8;
        }
    </style>
</head>

<body>

    <div class="container">

        <h1>🚀 IS Aggregation Service</h1>

        <div class="subtitle">
            Automated CI/CD Deployment using Modern DevOps Tools
        </div>

        <!-- Dynamically displayed deployment version -->
        <div class="version">
            Version: v{{ image_tag | default('latest') }}
        </div>

        <h2 class="pipeline-title">
            ⚙️ DevOps Deployment Pipeline
        </h2>

        <div class="pipeline">

            <div class="tool">👨‍💻 VS Code</div>
            <div class="arrow">→</div>

            <div class="tool">🐙 Git</div>
            <div class="arrow">→</div>

            <div class="tool">🐙 GitHub</div>
            <div class="arrow">→</div>

            <div class="tool">🔨 Jenkins</div>
            <div class="arrow">→</div>

            <div class="tool">🐳 Docker</div>
            <div class="arrow">→</div>

            <div class="tool">☁️ AWS ECR</div>
            <div class="arrow">→</div>

            <div class="tool">⚙️ Ansible</div>
            <div class="arrow">→</div>

            <div class="tool">🚀 Application Server</div>

        </div>

        <div class="footer">
            IS Aggregation Service | Automated Deployment
            <br>
            Deployed through Jenkins CI/CD Pipeline
        </div>

    </div>

</body>
</html>